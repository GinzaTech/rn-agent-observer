# ---- Dependencies (pnpm) ----
node_modules/
.pnpm/
.npm/
.cache/

# ---- Build outputs ----
dist/
coverage/
!packages/core/src/coverage/
!packages/core/src/coverage/**
*.tsbuildinfo

# ---- Observer runtime artifacts (root + any workspace app) ----
# Contents ignored, not the dirs, so .gitkeep exceptions keep working.
.artifacts/**
!/.artifacts/.gitkeep
artifacts/**
!/artifacts/.gitkeep
**/.artifacts/**
*.rnobs

# Observer policy/config is machine- and device-specific. Commit reviewed
# examples only; never commit a live authorized-active allowlist.
.rn-observer.json
**/.rn-observer.json
!.rn-observer.*.example.json

# Observer state/binary files (defensive — normally under .artifacts)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.perfetto-trace
*.cpuprofile

# ---- Expo / React Native (demo app) ----
.expo/
.expo-shared/
apps/demo-expo/android/
apps/demo-expo/ios/
.gradle/
local.properties
*.apk
*.aab
*.jks
*.keystore

# ---- Secrets / environment ----
.env
.env.*
!.env.example
!.env.*.example

# ---- Logs ----
*.log
npm-debug.log*
pnpm-debug.log*
test-results/
playwright-report/
*.junit.xml
*.sarif

# ---- Release bundles ----
release/

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- IDE / agent local state ----
.idea/
.vscode/
.fleet/
.history/
.cursor/
.claude/
.opencode/
*.tmp
*.swp
*.swo
