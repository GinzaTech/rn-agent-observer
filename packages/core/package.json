{
  "name": "@rn-agent-observer/core",
  "version": "2.5.1",
  "description": "Runtime evidence collection, diagnosis, replay, and comparison engine for RN Agent Observer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinzaTech/rn-agent-observer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/GinzaTech/rn-agent-observer/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/GinzaTech/rn-agent-observer/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "observability",
    "testing",
    "adb"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./targets": {
      "types": "./dist/targets/index.d.ts",
      "import": "./dist/targets/index.js"
    },
    "./coverage": {
      "types": "./dist/coverage/index.d.ts",
      "import": "./dist/coverage/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \\\"dist/**\\\""
  },
  "dependencies": {
    "@rn-agent-observer/schemas": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "fast-xml-parser": "^5.11.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0"
  }
}
