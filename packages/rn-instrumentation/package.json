{
  "name": "@rn-agent-observer/rn-instrumentation",
  "version": "2.4.1",
  "description": "Development-only React Native telemetry and interaction instrumentation for RN Agent Observer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinzaTech/rn-agent-observer.git",
    "directory": "packages/rn-instrumentation"
  },
  "homepage": "https://github.com/GinzaTech/rn-agent-observer/tree/main/packages/rn-instrumentation#readme",
  "bugs": {
    "url": "https://github.com/GinzaTech/rn-agent-observer/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "instrumentation",
    "observability",
    "telemetry",
    "babel-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./babel-plugin": "./babel-plugin.cjs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "babel-plugin.cjs",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \\\"dist/**\\\""
  },
  "devDependencies": {
    "@babel/core": "^7.0.0"
  },
  "peerDependencies": {
    "@babel/core": ">=7"
  }
}
