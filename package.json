{
  "name": "rn-agent-observer",
  "version": "2.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "rn-observe": "node packages/cli/dist/index.js",
    "mcp:check": "node packages/mcp-server/dist/server.js --check",
    "mcp:start": "node packages/mcp-server/dist/server.js",
    "release:check": "pnpm check && pnpm mcp:check && pnpm rn-observe --version"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
